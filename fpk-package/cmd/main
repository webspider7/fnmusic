#!/bin/bash
# ==============================================================================
#  飞牛 OS (fnOS) 极光音乐应用生命周期核心控制脚本 (start / stop / status)
# ==============================================================================

APP_DIR="${TRIM_APPDEST:-$(cd "$(dirname "$0")/.." && pwd)}"
APP_NAME="${TRIM_APPNAME:-fn-lx-player}"
VAR_DIR="${TRIM_PKGVAR:-${APP_DIR}/var}"

# 动态探测二进制路径（适配平铺和保留层级两种情况）
if [ -f "${APP_DIR}/fn-lx-player" ]; then
  BIN_PATH="${APP_DIR}/fn-lx-player"
elif [ -f "${APP_DIR}/app/fn-lx-player" ]; then
  BIN_PATH="${APP_DIR}/app/fn-lx-player"
else
  BIN_PATH="${APP_DIR}/fn-lx-player"
fi

PID_FILE="${VAR_DIR}/${APP_NAME}.pid"
DATA_DIR="${VAR_DIR}/data"

# 日志写到内存文件系统 /tmp，避免写到机械硬盘触发唤醒
LOG_FILE="/tmp/${APP_NAME}.log"

mkdir -p "${VAR_DIR}" "${DATA_DIR}"

log_error() {
    local msg="$1"
    echo "$msg"
    if [ -n "$TRIM_TEMP_LOGFILE" ]; then
        echo "$msg" > "$TRIM_TEMP_LOGFILE"
    fi
}

case "$1" in
  start)
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
      echo "${APP_NAME} 已经在运行中 (PID: $(cat "$PID_FILE"))."
      exit 0
    fi

    echo "正在启动 ${APP_NAME}..."
    chmod +x "${BIN_PATH}" 2>/dev/null || true
    chmod +x "${APP_DIR}/fn-lx-player" 2>/dev/null || true
    chmod +x "${APP_DIR}/app/fn-lx-player" 2>/dev/null || true

    if [ ! -f "${BIN_PATH}" ]; then
      log_error "未找到可执行文件: ${BIN_PATH} (APP_DIR: ${APP_DIR})"
      exit 1
    fi

    # 启动后台守护进程，端口 8899，日志写入 /tmp
    nohup "${BIN_PATH}" --port 8899 --data "${DATA_DIR}" > "${LOG_FILE}" 2>&1 &
    DAEMON_PID=$!
    echo "$DAEMON_PID" > "$PID_FILE"

    # 等待进程确认启动
    for i in {1..10}; do
      if kill -0 "$DAEMON_PID" 2>/dev/null; then
        echo "${APP_NAME} 启动成功 (PID: ${DAEMON_PID})."
        exit 0
      fi
      sleep 0.2
    done

    log_error "${APP_NAME} 启动失败，请查看日志: ${LOG_FILE}"
    exit 1
    ;;

  stop)
    echo "正在停止 ${APP_NAME}..."
    if [ -f "$PID_FILE" ]; then
      PID=$(cat "$PID_FILE")
      if kill -0 "$PID" 2>/dev/null; then
        kill "$PID" 2>/dev/null || true
        for i in {1..10}; do
          if ! kill -0 "$PID" 2>/dev/null; then
            break
          fi
          sleep 0.3
        done
        kill -9 "$PID" 2>/dev/null || true
      fi
      rm -f "$PID_FILE"
    else
      pkill -f "${BIN_PATH}" 2>/dev/null || true
      pkill -f "fn-lx-player" 2>/dev/null || true
    fi
    echo "${APP_NAME} 已停止."
    exit 0
    ;;

  status)
    if [ -f "$PID_FILE" ]; then
      PID=$(cat "$PID_FILE")
      if kill -0 "$PID" 2>/dev/null; then
        exit 0 # 0 表示正常运行中 (fnOS 规范)
      fi
    fi

    if pgrep -f "${BIN_PATH}" >/dev/null 2>&1; then
      exit 0
    fi

    exit 3 # 3 表示未运行 (fnOS 规范)
    ;;

  *)
    echo "使用方法: $0 {start|stop|status}"
    exit 1
    ;;
esac
